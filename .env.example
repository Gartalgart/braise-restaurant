# PostgreSQL
# - En ligne (Neon, via l'intégration Vercel) : les deux variables sont créées
#   automatiquement ; DATABASE_URL est la connexion poolée, DATABASE_URL_UNPOOLED la directe.
# - En local avec Docker (docker compose up -d db) : la même URL pour les deux.
DATABASE_URL="postgresql://braise:braise@localhost:5432/braise"
DATABASE_URL_UNPOOLED="postgresql://braise:braise@localhost:5432/braise"

# Stripe (optionnel — prépaiement groupes)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Maps (embed sans clé utilisé par défaut)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
